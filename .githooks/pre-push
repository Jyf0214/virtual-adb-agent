#!/usr/bin/env bash
#
# pre-push hook — 推送前完整语法 + 静态分析检查
#
# 检查内容：
#   1. Kotlin 语法（ktlint：未使用导入 + 风格 + 解析错误）
#   2. Detekt 死代码 / 不可达代码 / 复杂度分析
#   3. Android Lint 全局资源与符号检查
#   4. XML 格式（xmllint 完整验证）
#   5. Gradle 配置文件格式
#   6. AndroidManifest 结构
#
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

errors=0

# ─── 获取本次推送涉及的文件 ──────────────────────────────────

pushed_files=$(git ls-files '*.kt' '*.kts' '*.xml' '*.gradle' '*.gradle.kts' '*.properties' '*.toml')

# ─── 1. Kotlin 语法检查（ktlint 完整检查）────────────────────

echo -e "${YELLOW}▸ 检查 Kotlin 语法...${NC}"

kt_files=$(echo "$pushed_files" | grep -E '\.(kt|kts)$' || true)
if [ -n "$kt_files" ]; then
    if command -v ktlint &>/dev/null; then
        ktlint_errors=0
        for f in $kt_files; do
            if [ -f "$f" ]; then
                if ! ktlint "$f" 2>/dev/null; then
                    ktlint_errors=$((ktlint_errors + 1))
                fi
            fi
        done
        if [ "$ktlint_errors" -eq 0 ]; then
            echo -e "  ${GREEN}✓ Kotlin 语法检查通过${NC}"
        else
            echo -e "  ${RED}✗ 发现 $ktlint_errors 个文件有语法问题${NC}"
            echo -e "  ${YELLOW}  提示: 运行 'ktlint --format' 自动修复${NC}"
            errors=$((errors + ktlint_errors))
        fi
    else
        # 无 ktlint 时做基础检查
        for f in $kt_files; do
            if [ -f "$f" ]; then
                open_brace=$(grep -o '{' "$f" | wc -l || true)
                close_brace=$(grep -o '}' "$f" | wc -l || true)
                if [ "$open_brace" -ne "$close_brace" ]; then
                    echo -e "  ${RED}✗ $f: 花括号不匹配 { = $open_brace, } = $close_brace${NC}"
                    errors=$((errors + 1))
                fi
                open_paren=$(grep -o '(' "$f" | wc -l || true)
                close_paren=$(grep -o ')' "$f" | wc -l || true)
                if [ "$open_paren" -ne "$close_paren" ]; then
                    echo -e "  ${RED}✗ $f: 圆括号不匹配${NC}"
                    errors=$((errors + 1))
                fi
            fi
        done
        if [ "$errors" -eq 0 ]; then
            echo -e "  ${GREEN}✓ 基础括号检查通过${NC}"
        fi
    fi
else
    echo -e "  ${GREEN}✓ 无 Kotlin 文件变更${NC}"
fi

# ─── 2. Detekt 静态分析（死代码 / 不可达代码 / 复杂度）─────

echo -e "${YELLOW}▸ 运行 Detekt 静态分析（死代码检测）...${NC}"

if command -v gradle &>/dev/null; then
    if gradle detekt --quiet 2>/dev/null; then
        echo -e "  ${GREEN}✓ Detekt 静态分析通过${NC}"
    else
        echo -e "  ${RED}✗ Detekt 发现代码问题，请运行 'gradle detekt' 查看详情${NC}"
        echo -e "  ${YELLOW}  报告位置: build/reports/detekt/$(ls -t build/reports/detekt/ 2>/dev/null | head -1)${NC}"
        errors=$((errors + 1))
    fi
else
    echo -e "  ${YELLOW}⚠ 未找到 gradle，跳过 Detekt 分析${NC}"
fi

# ─── 3. Android Lint 检查 ───────────────────────────────────

echo -e "${YELLOW}▸ 运行 Android Lint...${NC}"

if command -v gradle &>/dev/null; then
    if gradle lint --quiet 2>/dev/null; then
        echo -e "  ${GREEN}✓ Android Lint 通过${NC}"
    else
        echo -e "  ${RED}✗ Android Lint 发现问题，请运行 'gradle lint' 查看详情${NC}"
        echo -e "  ${YELLOW}  报告位置: app/build/reports/lint-results.html${NC}"
        errors=$((errors + 1))
    fi
else
    echo -e "  ${YELLOW}⚠ 未找到 gradle，跳过 Android Lint${NC}"
fi

# ─── 4. XML 格式检查（xmllint）──────────────────────────────

echo -e "${YELLOW}▸ 检查 XML 格式...${NC}"

xml_files=$(echo "$pushed_files" | grep -E '\.xml$' || true)
if [ -n "$xml_files" ]; then
    if command -v xmllint &>/dev/null; then
        xml_errors=0
        for f in $xml_files; do
            if [ -f "$f" ]; then
                if ! xmllint --noout "$f" 2>/dev/null; then
                    echo -e "  ${RED}✗ $f: XML 格式错误${NC}"
                    xml_errors=$((xml_errors + 1))
                fi
            fi
        done
        if [ "$xml_errors" -eq 0 ]; then
            echo -e "  ${GREEN}✓ XML 格式检查通过${NC}"
        fi
        errors=$((errors + xml_errors))
    else
        echo -e "  ${YELLOW}⚠ 未找到 xmllint，跳过 XML 检查${NC}"
    fi
else
    echo -e "  ${GREEN}✓ 无 XML 文件变更${NC}"
fi

# ─── 5. Gradle 配置检查 ─────────────────────────────────────

echo -e "${YELLOW}▸ 检查 Gradle 配置...${NC}"

gradle_files=$(echo "$pushed_files" | grep -E '\.(gradle|gradle\.kts|properties|toml)$' || true)
if [ -n "$gradle_files" ]; then
    gradle_errors=0
    for f in $gradle_files; do
        if [ -f "$f" ]; then
            open_brace=$(grep -o '{' "$f" | wc -l || true)
            close_brace=$(grep -o '}' "$f" | wc -l || true)
            if [ "$open_brace" -ne "$close_brace" ]; then
                echo -e "  ${RED}✗ $f: 花括号不匹配${NC}"
                gradle_errors=$((gradle_errors + 1))
            fi
            open_paren=$(grep -o '(' "$f" | wc -l || true)
            close_paren=$(grep -o ')' "$f" | wc -l || true)
            if [ "$open_paren" -ne "$close_paren" ]; then
                echo -e "  ${RED}✗ $f: 圆括号不匹配${NC}"
                gradle_errors=$((gradle_errors + 1))
            fi
        fi
    done
    if [ "$gradle_errors" -eq 0 ]; then
        echo -e "  ${GREEN}✓ Gradle 配置检查通过${NC}"
    fi
    errors=$((errors + gradle_errors))
else
    echo -e "  ${GREEN}✓ 无 Gradle 配置变更${NC}"
fi

# ─── 6. AndroidManifest 检查 ────────────────────────────────

echo -e "${YELLOW}▸ 检查 AndroidManifest...${NC}"

manifest=$(echo "$pushed_files" | grep 'AndroidManifest.xml' || true)
if [ -n "$manifest" ]; then
    for f in $manifest; do
        if [ -f "$f" ]; then
            if ! grep -q '<application' "$f"; then
                echo -e "  ${RED}✗ $f: 缺少 <application> 标签${NC}"
                errors=$((errors + 1))
            fi
            has_ns=$(grep -q 'package=' "$f" && echo yes || \
                     grep -rq 'namespace' app/build.gradle.kts build.gradle.kts 2>/dev/null && echo yes || echo no)
            if [ "$has_ns" = "no" ]; then
                echo -e "  ${RED}✗ $f: 缺少 namespace/package 声明${NC}"
                errors=$((errors + 1))
            fi
            echo -e "  ${GREEN}✓ AndroidManifest 检查通过${NC}"
        fi
    done
else
    echo -e "  ${GREEN}✓ 无 AndroidManifest 变更${NC}"
fi

# ─── 汇总结果 ────────────────────────────────────────────────

echo ""
if [ "$errors" -gt 0 ]; then
    echo -e "${RED}═══ 推送被阻止: 发现 $errors 个问题 ═══${NC}"
    echo -e "${YELLOW}修复后重新推送${NC}"
    exit 1
else
    echo -e "${GREEN}═══ 所有检查通过 ✓ ═══${NC}"
    echo -e "${GREEN}允许推送${NC}"
    exit 0
fi
