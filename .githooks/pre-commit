#!/usr/bin/env bash
#
# pre-commit hook — 提交前语法检查
#
# 检查内容：
#   1. Kotlin 语法（ktlint：未使用的导入 + 解析错误）
#   2. XML 格式（xmllint）
#   3. 不允许提交包含敏感信息的文件
#
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

errors=0

# ─── 获取暂存的文件 ──────────────────────────────────────────

staged_kt=$(git diff --cached --name-only --diff-filter=ACM -- '*.kt' '*.kts')
staged_xml=$(git diff --cached --name-only --diff-filter=ACM -- '*.xml')

# ─── 1. Kotlin 语法检查（ktlint）────────────────────────────

if [ -n "$staged_kt" ]; then
    echo -e "${YELLOW}▸ 检查 Kotlin 语法...${NC}"

    if command -v ktlint &>/dev/null; then
        ktlint_errors=0
        for f in $staged_kt; do
            if [ -f "$f" ]; then
                if ! ktlint "$f" 2>/dev/null; then
                    ktlint_errors=$((ktlint_errors + 1))
                fi
            fi
        done
        if [ "$ktlint_errors" -eq 0 ]; then
            echo -e "  ${GREEN}✓ Kotlin 语法检查通过${NC}"
        else
            echo -e "  ${RED}✗ 发现 $ktlint_errors 个文件有问题${NC}"
            echo -e "  ${YELLOW}  提示: 运行 'ktlint --format' 自动修复${NC}"
            errors=$((errors + ktlint_errors))
        fi
    elif [ -f "./gradlew" ]; then
        if ./gradlew ktlintCheck --quiet 2>/dev/null; then
            echo -e "  ${GREEN}✓ Kotlin 语法检查通过${NC}"
        else
            echo -e "  ${RED}✗ Kotlin 语法有问题，请修复后重新提交${NC}"
            errors=$((errors + 1))
        fi
    else
        # 无 ktlint 时做基础括号匹配
        echo -e "  ${YELLOW}⚠ 未找到 ktlint，执行基础括号检查...${NC}"
        for f in $staged_kt; do
            if [ -f "$f" ]; then
                open=$(grep -o '{' "$f" | wc -l)
                close=$(grep -o '}' "$f" | wc -l)
                if [ "$open" -ne "$close" ]; then
                    echo -e "  ${RED}✗ $f: 花括号不匹配 { = $open, } = $close${NC}"
                    errors=$((errors + 1))
                fi
                open_paren=$(grep -o '(' "$f" | wc -l)
                close_paren=$(grep -o ')' "$f" | wc -l)
                if [ "$open_paren" -ne "$close_paren" ]; then
                    echo -e "  ${RED}✗ $f: 圆括号不匹配 ( ( = $open_paren, ) = $close_paren )${NC}"
                    errors=$((errors + 1))
                fi
            fi
        done
        if [ "$errors" -eq 0 ]; then
            echo -e "  ${GREEN}✓ 基础括号检查通过${NC}"
        fi
    fi
fi

# ─── 2. XML 格式检查（xmllint）──────────────────────────────

if [ -n "$staged_xml" ]; then
    echo -e "${YELLOW}▸ 检查 XML 格式...${NC}"

    if command -v xmllint &>/dev/null; then
        xml_errors=0
        for f in $staged_xml; do
            if [ -f "$f" ]; then
                if ! xmllint --noout "$f" 2>/dev/null; then
                    echo -e "  ${RED}✗ $f: XML 格式错误${NC}"
                    xml_errors=$((xml_errors + 1))
                fi
            fi
        done
        if [ "$xml_errors" -eq 0 ]; then
            echo -e "  ${GREEN}✓ XML 格式检查通过${NC}"
        else
            errors=$((errors + xml_errors))
        fi
    else
        echo -e "  ${YELLOW}⚠ 未找到 xmllint，跳过 XML 检查${NC}"
    fi
fi

# ─── 3. 敏感信息检查 ────────────────────────────────────────

echo -e "${YELLOW}▸ 检查敏感信息...${NC}"
secret_patterns=(
    'password\s*=\s*"[^"]+"'
    'api[_-]?key\s*=\s*"[^"]+"'
    'secret\s*=\s*"[^"]+"'
    'token\s*=\s*"[^"]+"'
    'PRIVATE KEY'
    'BEGIN RSA'
    'BEGIN EC PRIVATE'
)

secret_found=0
for f in $staged_kt $staged_xml; do
    if [ -f "$f" ]; then
        for pattern in "${secret_patterns[@]}"; do
            if grep -qiE "$pattern" "$f" 2>/dev/null; then
                match=$(grep -iE "$pattern" "$f" | head -1)
                echo -e "  ${RED}✗ $f: 疑似包含敏感信息${NC}"
                echo -e "    ${match}"
                secret_found=$((secret_found + 1))
            fi
        done
    fi
done

if [ "$secret_found" -eq 0 ]; then
    echo -e "  ${GREEN}✓ 未发现敏感信息${NC}"
else
    errors=$((errors + secret_found))
fi

# ─── 汇总结果 ────────────────────────────────────────────────

echo ""
if [ "$errors" -gt 0 ]; then
    echo -e "${RED}═══ 提交被阻止: 发现 $errors 个问题 ═══${NC}"
    echo -e "${YELLOW}修复后重新执行 'git commit'${NC}"
    exit 1
else
    echo -e "${GREEN}═══ 所有检查通过 ✓ ═══${NC}"
    exit 0
fi
